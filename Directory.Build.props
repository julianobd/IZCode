<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>

    <!-- Path to the game installation. Override it with -p:StationeersDir=... -->
    <StationeersDir Condition="'$(StationeersDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Stationeers</StationeersDir>
    <StationeersManaged>$(StationeersDir)\rocketstation_Data\Managed</StationeersManaged>
  </PropertyGroup>
</Project>
